+++ b/src/hyprvx/DriftSpike.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+// HyprVX U0 unified-world feasibility spike (DV3-12): throwaway, evidence only, never merged.
+//
+// While drift is on for a monitor, every regular workspace on it is placed in one world: workspace k has the region
+// offset R(k) = ((k - 1) * monitor width, 0). The world frame is anchored at the workspace that was active when drift
+// was turned on; the stored camera is in that frame. Rendering and input keep working in the active workspace's frame
+// (window offset 0), so the effective camera is the stored one shifted by R(active) - R(anchor) and a window of
+// another workspace has the offset O(w) = R(ws(w)) - R(active). Focusing a window of workspace k makes k active:
+// both change by the same amount, so nothing moves on screen. Workspace membership, layout positions, floating and
+// fullscreen state are never written (master plan C5).
+
+#include "../helpers/math/Math.hpp"
+#include "../helpers/time/Time.hpp"
+#include "../render/types.hpp"
+#include "../desktop/DesktopTypes.hpp"
+
+#include <cstdint>
+#include <string>
+
+namespace Monitor {
+    class CMonitor;
+}
+
+namespace HyprVX::Drift {
+    struct SFlags {
+        bool frames = false; // also send frame callbacks to drift-visible windows on frames without damage
+        bool awake  = false; // keep drift-visible windows out of the xdg_toplevel suspended state
+    };
+
+    bool                     on(const Monitor::CMonitor& monitor);
+    bool                     set(Monitor::CMonitor& monitor, bool enable, SFlags flags);
+    Vector2D                 shift(const Monitor::CMonitor& monitor);
+    Vector2D                 offset(const PHLWINDOW& window);
+
+    // isDriftVisible(w, m): a mapped window of a non-active regular workspace on m whose world box the camera shows.
+    bool                     visible(const PHLWINDOW& window, const PHLMONITOR& monitor);
+    bool                     keepAwake(const PHLWINDOW& window);
+
+    // The window pass of a drift monitor draws each window through its own camera hint, then restores the pass base.
+    void                     setPass(const Monitor::CMonitor& monitor, const Render::SRenderModifData& outer, const Render::SRenderModifData& base);
+    Render::SRenderModifData windowModif(const Monitor::CMonitor& monitor, const PHLWINDOW& window);
+    Render::SRenderModifData passBase(const Monitor::CMonitor& monitor);
+
+    PHLWINDOW                windowAt(const Monitor::CMonitor& monitor, const Vector2D& screen, uint64_t properties, const PHLWINDOW& ignore);
+    void                     sendFrames(const PHLMONITOR& monitor, const Time::steady_tp& now);
+    bool                     sendsFrames(const Monitor::CMonitor& monitor);
+
+    std::string              stateJSON(const Monitor::CMonitor& monitor);
+}
