diff --git a/src/hyprvx/DriftSpike.cpp b/src/hyprvx/DriftSpike.cpp
new file mode 100644
index 00000000..dbd6a1f3
--- /dev/null
+++ b/src/hyprvx/DriftSpike.cpp
@@ -0,0 +1,162 @@
+#include "DriftSpike.hpp"
+#include "SceneCamera.hpp"
+
+#include "../output/Monitor.hpp"
+#include "../desktop/Workspace.hpp"
+#include "../desktop/view/Window.hpp"
+#include "../desktop/view/WLSurface.hpp"
+#include "../desktop/state/WindowState.hpp"
+#include "../desktop/state/GlobalWindowController.hpp"
+#include "../protocols/core/Compositor.hpp"
+#include "../render/Renderer.hpp"
+#include "../state/MonitorState.hpp"
+#include "../debug/log/Logger.hpp"
+
+#include <format>
+#include <ranges>
+#include <unordered_map>
+
+using namespace hyprvx;
+using namespace Render;
+
+namespace {
+    struct SState {
+        WORKSPACEID           anchor = WORKSPACE_INVALID;
+        HyprVX::Drift::SFlags flags;
+        SRenderModifData      outer, base;
+    };
+
+    std::unordered_map<MONITORID, SState>& states() {
+        static std::unordered_map<MONITORID, SState> s;
+        return s;
+    }
+
+    const SState* stateOf(const Monitor::CMonitor& monitor) {
+        const auto IT = states().find(monitor.m_id);
+        return IT == states().end() ? nullptr : &IT->second;
+    }
+
+    bool regular(const PHLWORKSPACE& ws) {
+        return ws && !ws->m_isSpecialWorkspace && ws->m_id > 0;
+    }
+
+    Vector2D region(const Monitor::CMonitor& monitor, WORKSPACEID id) {
+        return {sc<double>(id - 1) * monitor.m_size.x, 0.0};
+    }
+
+    // The window's monitor for drift purposes: the monitor of its regular workspace, if drift is on there.
+    PHLMONITOR driftMonitorOf(const PHLWINDOW& window) {
+        if (!window || !regular(window->m_workspace))
+            return nullptr;
+        const auto MONITOR = window->m_workspace->m_monitor.lock();
+        return MONITOR && stateOf(*MONITOR) ? MONITOR : nullptr;
+    }
+}
+
+bool HyprVX::Drift::on(const Monitor::CMonitor& monitor) {
+    return stateOf(monitor) != nullptr;
+}
+
+bool HyprVX::Drift::set(Monitor::CMonitor& monitor, bool enable, SFlags flags) {
+    if (enable) {
+        if (!regular(monitor.m_activeWorkspace))
+            return false;
+        auto& state = states()[monitor.m_id];
+        if (state.anchor == WORKSPACE_INVALID)
+            state.anchor = monitor.m_activeWorkspace->m_id;
+        state.flags = flags;
+    } else
+        states().erase(monitor.m_id);
+
+    Log::logger->log(Log::WARN, "[hyprvx] U0 drift {} on {} (frames {}, awake {})", enable ? "on" : "off", monitor.m_name, flags.frames, flags.awake);
+    Desktop::globalWindowController()->updateSuspendedStates();
+    if (g_pHyprRenderer)
+        g_pHyprRenderer->damageMonitor(monitor.m_self.lock());
+    return true;
+}
+
+Vector2D HyprVX::Drift::shift(const Monitor::CMonitor& monitor) {
+    const auto STATE = stateOf(monitor);
+    if (!STATE || !regular(monitor.m_activeWorkspace))
+        return {};
+    return region(monitor, monitor.m_activeWorkspace->m_id) - region(monitor, STATE->anchor);
+}
+
+Vector2D HyprVX::Drift::offset(const PHLWINDOW& window) {
+    const auto MONITOR = driftMonitorOf(window);
+    if (!MONITOR || !regular(MONITOR->m_activeWorkspace))
+        return {};
+    return region(*MONITOR, window->m_workspace->m_id) - region(*MONITOR, MONITOR->m_activeWorkspace->m_id);
+}
+
+bool HyprVX::Drift::visible(const PHLWINDOW& window, const PHLMONITOR& monitor) {
+    if (!monitor || !window || !window->m_isMapped || window->isHidden())
+        return false;
+    if (driftMonitorOf(window) != monitor || window->m_workspace == monitor->m_activeWorkspace)
+        return false;
+
+    const auto VIEW = cammath::visibleWorldRect(cameraOf(*monitor), {monitor->m_size.x, monitor->m_size.y});
+    return window->getFullWindowBoundingBox().translate(offset(window)).overlaps({VIEW.pos.x, VIEW.pos.y, VIEW.size.x, VIEW.size.y});
+}
+
+bool HyprVX::Drift::keepAwake(const PHLWINDOW& window) {
+    const auto MONITOR = driftMonitorOf(window);
+    return MONITOR && stateOf(*MONITOR)->flags.awake && visible(window, MONITOR);
+}
+
+void HyprVX::Drift::setPass(const Monitor::CMonitor& monitor, const SRenderModifData& outer, const SRenderModifData& base) {
+    const auto IT = states().find(monitor.m_id);
+    if (IT == states().end())
+        return;
+    IT->second.outer = outer;
+    IT->second.base  = base;
+}
+
+SRenderModifData HyprVX::Drift::windowModif(const Monitor::CMonitor& monitor, const PHLWINDOW& window) {
+    // The window is drawn at L(w) + its workspace's render offset; it belongs at L(w) + O(w). Shifting the camera
+    // origin by the difference keeps the single camera transform (Constitution IV): P' = P - O(w) + renderOffset.
+    const auto DELTA = offset(window) - (window->m_pinned ? Vector2D{} : window->m_workspace->m_renderOffset->value());
+    const auto STATE = stateOf(monitor);
+    return cameraRenderModif(monitor, cammath::panByWorld(cameraOf(monitor), {DELTA.x, DELTA.y}), STATE ? STATE->outer : SRenderModifData{});
+}
+
+SRenderModifData HyprVX::Drift::passBase(const Monitor::CMonitor& monitor) {
+    const auto STATE = stateOf(monitor);
+    return STATE ? STATE->base : SRenderModifData{};
+}
+
+PHLWINDOW HyprVX::Drift::windowAt(const Monitor::CMonitor& monitor, const Vector2D& screen, uint64_t properties, const PHLWINDOW& ignore) {
+    if (!on(monitor))
+        return nullptr;
+
+    const auto WORLD   = cammath::inverse(cameraOf(monitor), monitorOrigin(monitor), {screen.x, screen.y});
+    const auto MONITOR = monitor.m_self.lock();
+    for (auto const& w : Desktop::windowState()->windows() | std::views::reverse) {
+        if (w == ignore || !w->acceptsInput() || w->m_ruleApplicator->noFocus().valueOrDefault() || !visible(w, MONITOR))
+            continue;
+        if (w->getWindowBoxUnified(properties).containsPoint(Vector2D{WORLD.x, WORLD.y} - offset(w)))
+            return w;
+    }
+    return nullptr;
+}
+
+void HyprVX::Drift::sendFrames(const PHLMONITOR& monitor, const Time::steady_tp& now) {
+    for (auto const& w : Desktop::windowState()->windows()) {
+        if (visible(w, monitor) && w->wlSurface() && w->wlSurface()->resource())
+            w->wlSurface()->resource()->breadthfirst([now](SP<CWLSurfaceResource> s, const Vector2D&, void*) { s->frame(now); }, nullptr);
+    }
+}
+
+bool HyprVX::Drift::sendsFrames(const Monitor::CMonitor& monitor) {
+    const auto STATE = stateOf(monitor);
+    return STATE && STATE->flags.frames;
+}
+
+std::string HyprVX::Drift::stateJSON(const Monitor::CMonitor& monitor) {
+    const auto STATE = stateOf(monitor);
+    if (!STATE)
+        return R"("drift":false)";
+    const auto SHIFT = shift(monitor);
+    return std::format(R"("drift":true,"anchor":{},"active":{},"shift":[{:.17g},{:.17g}],"frames":{},"awake":{})", STATE->anchor,
+                       monitor.m_activeWorkspace ? monitor.m_activeWorkspace->m_id : WORKSPACE_INVALID, SHIFT.x, SHIFT.y, STATE->flags.frames, STATE->flags.awake);
+}
