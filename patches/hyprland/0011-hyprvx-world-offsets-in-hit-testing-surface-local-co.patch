     if (*PNOWARPS)
         return;
 
-    // HyprVX: the window box is in world coordinates.
-    if (Desktop::focusState()->window())
-        Desktop::focusState()->window()->m_relativeCursorCoordsOnLastWarp =
-            HyprVX::screenToWorld(g_pInputManager->getMouseCoordsInternal()) - Desktop::focusState()->window()->layoutBox().pos();
+    // HyprVX: the window box is in world coordinates, drawn at L + O(w) (Feature 002).
+    if (const auto PWINDOW = Desktop::focusState()->window(); PWINDOW)
+        PWINDOW->m_relativeCursorCoordsOnLastWarp = HyprVX::screenToWorld(g_pInputManager->getMouseCoordsInternal()) - HyprVX::appliedOffset(*PWINDOW) - PWINDOW->layoutBox().pos();
 }
 
