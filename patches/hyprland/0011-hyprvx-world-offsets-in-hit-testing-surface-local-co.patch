-    const auto toScreen = [&PMONITOR](const Vector2D& world) { return PMONITOR ? HyprVX::worldToScreen(*PMONITOR, world) : world; };
+    // Feature 002: the window is drawn at its world box L + O(w).
+    const auto OFFSET   = HyprVX::appliedOffset(*this);
+    const auto toScreen = [&PMONITOR, &OFFSET](const Vector2D& world) { return PMONITOR ? HyprVX::worldToScreen(*PMONITOR, world + OFFSET) : world + OFFSET; };
 
