@@ -0,0 +1,9 @@
+#pragma once
+
+// HyprVX dev-only camera control (patch 0005, contracts/dev-control.md). Built only with HYPRVX_DEV; for nested test
+// sessions, never a product interface.
+
+namespace HyprVX {
+    // Registers the hyprvx-dev:* dispatchers and the `hyprctl hyprvx-dev <command> [args]` command.
+    void registerDevControl();
+}
