diff --git a/src/hyprvx/DevControl.cpp b/src/hyprvx/DevControl.cpp
new file mode 100644
index 00000000..ac973a36
--- /dev/null
+++ b/src/hyprvx/DevControl.cpp
@@ -0,0 +1,169 @@
+#include "DevControl.hpp"
+
+#ifdef HYPRVX_DEV
+
+#include "MonitorCamera.hpp"
+
+#include "../output/Monitor.hpp"
+#include "../state/MonitorState.hpp"
+#include "../state/MonitorQuery.hpp"
+#include "../desktop/state/FocusState.hpp"
+#include "../managers/KeybindManager.hpp"
+#include "../debug/HyprCtl.hpp"
+#include "../render/Renderer.hpp"
+#include "../helpers/MiscFunctions.hpp"
+#include "../debug/log/Logger.hpp"
+
+#include <charconv>
+#include <format>
+#include <functional>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+using namespace hyprvx;
+
+namespace {
+    std::vector<std::string_view> splitWords(std::string_view args) {
+        std::vector<std::string_view> words;
+        size_t                        pos = 0;
+        while (pos < args.size()) {
+            const auto START = args.find_first_not_of(" \t", pos);
+            if (START == std::string_view::npos)
+                break;
+            const auto END = std::min(args.find_first_of(" \t", START), args.size());
+            words.emplace_back(args.substr(START, END - START));
+            pos = END;
+        }
+        return words;
+    }
+
+    std::optional<double> parseNumber(std::string_view word) {
+        double     value = 0.0;
+        const auto RES   = std::from_chars(word.data(), word.data() + word.size(), value);
+        if (RES.ec != std::errc{} || RES.ptr != word.data() + word.size())
+            return std::nullopt;
+        return value;
+    }
+
+    SDispatchResult error(std::string code) {
+        return {.success = false, .error = std::move(code)};
+    }
+
+    // <Px> <Py> <z>; validation is cammath::validate inside setCamera (no change on rejection).
+    SDispatchResult setFromWords(const PHLMONITOR& monitor, const std::vector<std::string_view>& words) {
+        if (!monitor)
+            return error("err:monitor");
+        if (words.size() != 3)
+            return error("err:invalid");
+
+        const auto PX = parseNumber(words[0]);
+        const auto PY = parseNumber(words[1]);
+        const auto Z  = parseNumber(words[2]);
+        if (!PX || !PY || !Z)
+            return error("err:invalid");
+
+        if (!HyprVX::setCamera(*monitor, {{*PX, *PY}, *Z}))
+            return error("err:invalid");
+        return {};
+    }
+
+    SDispatchResult camera(std::string args) {
+        return setFromWords(Desktop::focusState()->monitor(), splitWords(args));
+    }
+
+    SDispatchResult cameraMon(std::string args) {
+        auto words = splitWords(args);
+        if (words.empty())
+            return error("err:monitor");
+
+        const auto MONITOR = State::monitorState()->query().name(words.front()).run();
+        if (!MONITOR)
+            return error("err:monitor");
+
+        words.erase(words.begin());
+        return setFromWords(MONITOR, words);
+    }
+
+    // Never fails: every camera returns to exact identity (the scene has no other state in Feature 001).
+    SDispatchResult panic(std::string) {
+        for (auto const& m : State::monitorState()->monitors())
+            HyprVX::resetCamera(*m);
+        Log::logger->log(Log::WARN, "[hyprvx] panic: all cameras reset to identity");
+        return {};
+    }
+
+    SDispatchResult fullDamage(std::string) {
+        for (auto const& m : State::monitorState()->monitors())
+            g_pHyprRenderer->damageMonitor(m);
+        return {};
+    }
+
+    // Bookkeeping only (Constitution II): never a pass condition.
+    std::string stateJSON() {
+        std::string out = "[";
+        for (auto const& m : State::monitorState()->monitors()) {
+            const auto CAMERA = HyprVX::cameraOf(*m);
+            if (out.size() > 1)
+                out += ",";
+            out += std::format(R"({{"monitor":"{}","P":[{:.17g},{:.17g}],"z":{:.17g},"identity":{},"revision":{},"passElementsAdded":{}}})", escapeJSONStrings(m->m_name),
+                               CAMERA.origin.x, CAMERA.origin.y, CAMERA.zoom, HyprVX::cameraIsIdentity(*m), m->m_hyprvxCamera.revision, m->m_hyprvxCamera.passElementsAdded);
+        }
+        return out + "]";
+    }
+
+    SDispatchResult state(std::string) {
+        Log::logger->log(Log::DEBUG, "[hyprvx] state: {}", stateJSON());
+        return {};
+    }
+
+    struct SCommand {
+        std::string_view                            name;
+        std::function<SDispatchResult(std::string)> fn;
+    };
+
+    const std::vector<SCommand>& commands() {
+        static const std::vector<SCommand> COMMANDS = {
+            {"camera", camera}, {"camera-mon", cameraMon}, {"panic", panic}, {"state", state}, {"full-damage", fullDamage},
+        };
+        return COMMANDS;
+    }
+
+    // `hyprctl hyprvx-dev <command> [args]`: works with either config parser, and returns the state JSON.
+    std::string hyprctlCommand(eHyprCtlOutputFormat, std::string in) {
+        const auto WORDS = splitWords(in);
+        if (WORDS.size() < 2)
+            return "err:invalid";
+
+        const auto NAME = WORDS[1];
+        if (NAME == "state")
+            return stateJSON();
+
+        const auto START = sc<size_t>(NAME.data() - in.data()) + NAME.size();
+        const auto ARGS  = START < in.size() ? in.substr(START) : std::string{};
+        for (auto const& c : commands()) {
+            if (c.name != NAME)
+                continue;
+            const auto RES = c.fn(ARGS);
+            return RES.success ? "ok" : RES.error;
+        }
+        return "err:invalid";
+    }
+}
+
+void HyprVX::registerDevControl() {
+    for (auto const& c : commands())
+        g_pKeybindManager->m_dispatchers[std::format("hyprvx-dev:{}", c.name)] = c.fn;
+
+    g_pHyprCtl->registerCommand(SHyprCtlCommand{.name = "hyprvx-dev", .exact = false, .fn = hyprctlCommand});
+    Log::logger->log(Log::WARN, "[hyprvx] dev camera control enabled (HYPRVX_DEV build)");
+}
+
+#else
+
+void HyprVX::registerDevControl() {
+    ;
+}
+
+#endif
diff --git a/src/hyprvx/DevControl.hpp b/src/hyprvx/DevControl.hpp
