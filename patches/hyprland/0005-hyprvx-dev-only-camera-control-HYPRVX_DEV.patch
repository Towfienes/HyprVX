@@ -17,6 +17,8 @@ namespace HyprVX {
         bool                         active = false;
         // Incremented on every change; drives full-output damage.
         uint64_t revision = 0;
+        // Camera hint elements added to render passes (identity must add none; dev-control state).
+        uint64_t passElementsAdded = 0;
     };
 
     // MVP zoom range (data-model.md).
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index 561e8dc0..5b23d81b 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -1182,9 +1182,11 @@ void IHyprRenderer::renderAllClientsForWorkspace(PHLMONITOR pMonitor, PHLWORKSPA
     // HyprVX: camera hint over the window pass, composed in front of the geometry modifier; none when identity (FR-002)
     const auto HYPRVXCAMERA     = pWorkspace == pMonitor->m_activeWorkspace ? HyprVX::activeCamera(*pMonitor) : std::nullopt;
     const auto pushHyprvxCamera = [&](bool on) {
-        if UNLIKELY (HYPRVXCAMERA)
+        if UNLIKELY (HYPRVXCAMERA) {
+            pMonitor->m_hyprvxCamera.passElementsAdded++;
             m_renderPass.add(makeUnique<CRendererHintsPassElement>(
                 CRendererHintsPassElement::SData{on ? HyprVX::cameraRenderModif(*pMonitor, *HYPRVXCAMERA, RENDERMODIFDATA) : RENDERMODIFDATA}));
+        }
     };
     pushHyprvxCamera(true);
 
