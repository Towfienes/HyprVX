@@ -0,0 +1,18 @@
+#pragma once
+
+// HyprVX: which camera applies to a monitor's window pass, and its render modifier (patch 0002).
+
+#include "MonitorCamera.hpp"
+#include "../render/types.hpp"
+
+#include <optional>
+
+namespace HyprVX {
+    // The camera for the monitor's window pass, or nullopt for the stock path: identity camera, no active
+    // workspace, or a fullscreen active workspace (fullscreen renders with the identity camera).
+    std::optional<hyprvx::cammath::CameraState> activeCamera(const Monitor::CMonitor& monitor);
+
+    // Render modifier equivalent to cammath::forward in monitor pixels, applied before the outer modifiers.
+    // Marked hyprvxCamera so that clip and damage are transformed with it.
+    Render::SRenderModifData cameraRenderModif(const Monitor::CMonitor& monitor, const hyprvx::cammath::CameraState& camera, const Render::SRenderModifData& outer);
+}
