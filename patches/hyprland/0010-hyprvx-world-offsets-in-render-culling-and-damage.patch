@@ -0,0 +1,40 @@
+#pragma once
+
+// HyprVX world offsets O(w) (patch 0010, Feature 002 contracts/mechanism-api.md 1.0, transform contract 1.2). HyprVX
+// owns them; a window's world box is its logical box plus O(w). Hyprland's window model (workspace, logical geometry,
+// tiled/floating state, layout) is never written (Constitution V). Every seam reads the offset through
+// appliedOffset/appliedContentOffset, so the storage stays private to WindowOffset.cpp.
+
+#include "../helpers/math/Math.hpp"
+#include "../helpers/memory/Memory.hpp"
+#include "../desktop/DesktopTypes.hpp"
+
+class CWLSurfaceResource;
+
+namespace Monitor {
+    class CMonitor;
+}
+
+namespace HyprVX {
+    // Rejects non-finite values (unchanged, logged). A change damages the window's old and new drawn boxes, popups
+    // included; setting the current value does nothing. Offset 0 removes the entry.
+    bool setWindowOffset(const PHLWINDOW& window, const Vector2D& offset);
+    // The value set, or 0 if never set; destroyed windows drop their entry.
+    Vector2D windowOffset(const PHLWINDOW& window);
+    // The window that owns a surface: the window itself, its subsurfaces, its popups and their subsurfaces. Null for
+    // layer surfaces and their popups, lock, IME and cursor surfaces, and surfaces without a desktop view.
+    PHLWINDOW contentOwner(const SP<CWLSurfaceResource>& surface);
+    // windowOffset(contentOwner(surface)); 0 when there is no owner window.
+    Vector2D contentOffset(const SP<CWLSurfaceResource>& surface);
+    // Every offset -> 0 (dev panic, plugin unload).
+    void resetWindowOffsets();
+
+    // What the seams apply: the window's offset, or 0 while its workspace has a fullscreen window (FR-012).
+    Vector2D appliedOffset(const Desktop::View::CWindow& window);
+    Vector2D appliedContentOffset(const SP<CWLSurfaceResource>& surface);
+    // True while any window has a non-zero offset: pass simplification, direct scanout and solitary client are off.
+    bool anyWindowOffset();
+    // Damage-union rule (0004) for boxes whose owner is unknown (damageBox): the box is also damaged at box + O for
+    // every distinct non-zero applied offset, through the monitor's camera. Over-damage only, never a stale region.
+    void addOffsetDamage(Monitor::CMonitor& monitor, const CBox& globalLogical);
+}
