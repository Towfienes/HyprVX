+
+SRenderModifData HyprVX::windowRenderModif(const Monitor::CMonitor& monitor, const Vector2D& offset) {
+    const auto& PASS   = windowPass();
+    const auto  CAMERA = PASS.camera.value_or(cammath::identityFor(monitorOrigin(monitor)));
+    return cameraRenderModif(monitor, cammath::offsetCamera(CAMERA, {offset.x, offset.y}), PASS.outer);
+}
+
+SRenderModifData HyprVX::passRenderModif(const Monitor::CMonitor& monitor) {
+    const auto& PASS = windowPass();
+    return PASS.camera ? cameraRenderModif(monitor, *PASS.camera, PASS.outer) : PASS.outer;
+}
+
+void HyprVX::notePassElements(Monitor::CMonitor& monitor, uint64_t count) {
+    monitor.m_hyprvxCamera.passElementsAdded += count;
+}
