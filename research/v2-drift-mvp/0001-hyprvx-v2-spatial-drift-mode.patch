 3 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/src/desktop/view/Window.cpp b/src/desktop/view/Window.cpp
index 8836f73..817cf69 100644
--- a/src/desktop/view/Window.cpp
+++ b/src/desktop/view/Window.cpp
@@ -449,7 +449,7 @@ void CWindow::uncacheWindowDecos() {
 }
 
 bool CWindow::checkInputOnDecos(const eInputType type, const Vector2D& mouseCoords, std::any data) {
-    if (type != INPUT_TYPE_DRAG_END && hasPopupAt(mouseCoords))
+    if (type != INPUT_TYPE_DRAG_END && hasPopupAtScreen(mouseCoords))
         return false;
 
     for (auto const& wd : m_windowDecorations) {
@@ -1054,7 +1054,7 @@ bool CWindow::isInCurvedCorner(double x, double y) {
     return false;
 }
 
-// checks if the wayland window has a popup at pos
+// checks if the wayland window has a popup at pos (pos is in logical window/monitor coords)
 bool CWindow::hasPopupAt(const Vector2D& pos) {
     if (m_isX11 || !m_popupHead)
         return false;
@@ -1067,6 +1067,22 @@ bool CWindow::hasPopupAt(const Vector2D& pos) {
     return popup && popup->wlSurface()->resource();
 }
 
+// checks if the wayland window has a popup at raw screen pos (screenPos is transformed via spatial camera)
+bool CWindow::hasPopupAtScreen(const Vector2D& screenPos) {
+    if (m_isX11 || !m_popupHead)
+        return false;
+
+    if (m_popupHead->popupTreeCount() == 0)
+        return false;
+
+    auto testPos = screenPos;
+    const auto PMONITOR = m_monitor.lock();
+    if (PMONITOR && PMONITOR->m_spatialCamera.enabled && std::isfinite(PMONITOR->m_spatialCamera.zoom) && PMONITOR->m_spatialCamera.zoom > 0.0001f)
+        testPos = PMONITOR->m_position + PMONITOR->m_spatialCamera.pan + (screenPos - PMONITOR->m_position) / PMONITOR->m_spatialCamera.zoom;
+
+    return hasPopupAt(testPos);
+}
+
 Vector2D CWindow::middle() {
     return m_realPosition->goal() + m_realSize->goal() / 2.f;
 }
@@ -1192,6 +1208,13 @@ bool CWindow::visibleOnMonitor(PHLMONITOR pMonitor) {
     if (m_isFloating)
         wbox = getFullWindowBoundingBox();
 
+    if (pMonitor && pMonitor->m_spatialCamera.enabled && std::isfinite(pMonitor->m_spatialCamera.zoom) && pMonitor->m_spatialCamera.zoom > 0.0001f) {
+        wbox.translate(-pMonitor->m_position);
+        wbox.translate(-pMonitor->m_spatialCamera.pan);
+        wbox.scale(pMonitor->m_spatialCamera.zoom);
+        wbox.translate(pMonitor->m_position);
+    }
+
     return !wbox.intersection({pMonitor->m_position, pMonitor->m_size}).empty();
 }
 
