+    const bool HAS_SPATIAL = pMonitor->m_spatialCamera.enabled && std::isfinite(pMonitor->m_spatialCamera.zoom) && pMonitor->m_spatialCamera.zoom > 0.0001f;
+    if (HAS_SPATIAL) {
+        SRenderModifData SPATIALMODIF;
+        if (pMonitor->m_spatialCamera.pan != Vector2D{0, 0})
+            SPATIALMODIF.modifs.emplace_back(SRenderModifData::eRenderModifType::RMOD_TYPE_TRANSLATE, -pMonitor->m_spatialCamera.pan * pMonitor->m_scale);
+        if (pMonitor->m_spatialCamera.zoom != 1.f)
+            SPATIALMODIF.modifs.emplace_back(SRenderModifData::eRenderModifType::RMOD_TYPE_SCALE, pMonitor->m_spatialCamera.zoom);
+        m_renderPass.add(makeUnique<CRendererHintsPassElement>(CRendererHintsPassElement::SData{SPATIALMODIF}));
+    }
+
     if UNLIKELY /* subjective? */ (Fullscreen::controller()->hasFullscreen(pWorkspace))
         renderWorkspaceWindowsFullscreen(pMonitor, pWorkspace, time);
     else
@@ -1228,6 +1238,13 @@ void IHyprRenderer::renderAllClientsForWorkspace(PHLMONITOR pMonitor, PHLWORKSPA
         renderWindow(w, pMonitor, time, true, RENDER_PASS_ALL);
     }
 
+    if (HAS_SPATIAL) {
+        if (!RENDERMODIFDATA.modifs.empty())
+            m_renderPass.add(makeUnique<CRendererHintsPassElement>(CRendererHintsPassElement::SData{RENDERMODIFDATA}));
+        else
+            m_renderPass.add(makeUnique<CRendererHintsPassElement>(CRendererHintsPassElement::SData{SRenderModifData{}}));
+    }
+
     Event::bus()->m_events.render.stage.emit(RENDER_POST_WINDOWS);
 
     // Render surfaces above windows for monitor
@@ -2741,11 +2758,20 @@ void IHyprRenderer::damageSurface(SP<CWLSurfaceResource> pSurface, double x, dou
     for (auto const& m : State::monitorState()->monitors()) {
         if (!m->m_output)
             continue;
-        if (!EXTENTS.overlaps(m->logicalBox()))
+        const bool IS_LAYER = WLSURF && WLSURF->view() && Desktop::View::CLayerSurface::fromView(WLSURF->view());
+        CBox testExtents = EXTENTS;
+        if (m->m_spatialCamera.enabled && !IS_LAYER && std::isfinite(m->m_spatialCamera.zoom) && m->m_spatialCamera.zoom > 0.0001f) {
+            testExtents.translate(-m->m_position).translate(-m->m_spatialCamera.pan).scale(m->m_spatialCamera.zoom).translate(m->m_position);
+        }
+        if (!testExtents.overlaps(m->logicalBox()))
             continue;
 
         damageBoxForEach.set(damageBox);
-        damageBoxForEach.translate({-m->m_position.x, -m->m_position.y}).scale(m->m_scale);
+        damageBoxForEach.translate({-m->m_position.x, -m->m_position.y});
+        if (m->m_spatialCamera.enabled && !IS_LAYER && std::isfinite(m->m_spatialCamera.zoom) && m->m_spatialCamera.zoom > 0.0001f) {
+            damageBoxForEach.translate(-m->m_spatialCamera.pan).scale(m->m_spatialCamera.zoom);
+        }
+        damageBoxForEach.scale(m->m_scale);
 
         m->addDamage(damageBoxForEach);
     }
@@ -2767,6 +2793,10 @@ void IHyprRenderer::damageWindow(PHLWINDOW pWindow, bool forceFull) {
     for (auto const& m : State::monitorState()->monitors()) {
         if (forceFull || shouldRenderWindow(pWindow, m)) { // only damage if window is rendered on monitor
             CBox fixedDamageBox = {windowBox.x - m->m_position.x, windowBox.y - m->m_position.y, windowBox.width, windowBox.height};
+            if (m->m_spatialCamera.enabled && std::isfinite(m->m_spatialCamera.zoom) && m->m_spatialCamera.zoom > 0.0001f) {
+                fixedDamageBox.translate(-m->m_spatialCamera.pan);
+                fixedDamageBox.scale(m->m_spatialCamera.zoom);
+            }
             fixedDamageBox.scale(m->m_scale).round();
             m->addDamage(fixedDamageBox);
         }
