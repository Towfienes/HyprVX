From d21155504eb4f6a11c4c8614b9ea2417f7c16133 Mon Sep 17 00:00:00 2001
From: Towfienes <ngolamtien1706@gmail.com>
Date: Wed, 7 Oct 2026 18:10:02 +0700
Subject: [PATCH 1/3] feat(v2): add reversible drift mode state and spatial
 camera dispatchers

---
 src/managers/KeybindManager.cpp | 152 ++++++++++++++++++++++++++++++++
 src/output/Monitor.hpp          |   8 ++
 2 files changed, 160 insertions(+)

diff --git a/src/managers/KeybindManager.cpp b/src/managers/KeybindManager.cpp
index 4ab407e..e4dc52e 100644
--- a/src/managers/KeybindManager.cpp
+++ b/src/managers/KeybindManager.cpp
@@ -18,8 +18,12 @@
 #include "../managers/input/InputManager.hpp"
 #include "../layout/LayoutManager.hpp"
 #include "../event/EventBus.hpp"
+#include "../desktop/state/FocusState.hpp"
+#include "../state/MonitorState.hpp"
+#include "../render/Renderer.hpp"
 #include <string>
 #include <cstring>
+#include <sstream>
 
 #include <hyprutils/string/String.hpp>
 #include <hyprutils/utils/ScopeGuard.hpp>
@@ -113,6 +117,154 @@ CKeybindManager::CKeybindManager() {
         m_dispatchers[name] = [n = std::string(name)](std::string args) -> SDispatchResult { return Config::Legacy::translator()->run(n, args); };
     }
 
+    // --------------------------------------------------------------------------
+    // HyprVX-v2: Drift Mode Spatial Camera Dispatchers
+    // --------------------------------------------------------------------------
+    auto getHyprVXMonitor = []() -> PHLMONITOR {
+        auto pMonitor = Desktop::focusState()->monitor();
+        if (!pMonitor && !State::monitorState()->monitors().empty())
+            pMonitor = State::monitorState()->monitors().front();
+        return pMonitor;
+    };
+
+    auto zoomCamera = [](PHLMONITOR PMONITOR, float deltaZoom) {
+        if (!PMONITOR)
+            return;
+        const float oldZoom = (std::isfinite(PMONITOR->m_spatialCamera.zoom) && PMONITOR->m_spatialCamera.zoom > 0.0001f) ? PMONITOR->m_spatialCamera.zoom : 1.0f;
+        const float newZoom = std::clamp(oldZoom + deltaZoom, 0.20f, 1.50f);
+        if (std::abs(newZoom - oldZoom) < 0.0001f)
+            return;
+        const Vector2D center = PMONITOR->m_size / 2.f;
+        PMONITOR->m_spatialCamera.pan = PMONITOR->m_spatialCamera.pan + center * (1.0f / oldZoom - 1.0f / newZoom);
+        PMONITOR->m_spatialCamera.zoom = newZoom;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] zoom -> zoom={:.2f}, pan=({:.1f}, {:.1f})", newZoom, PMONITOR->m_spatialCamera.pan.x, PMONITOR->m_spatialCamera.pan.y);
+    };
+
+    auto panCamera = [](PHLMONITOR PMONITOR, const Vector2D& delta) {
+        if (!PMONITOR)
+            return;
+        PMONITOR->m_spatialCamera.pan = PMONITOR->m_spatialCamera.pan + delta;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] pan -> pan=({:.1f}, {:.1f})", PMONITOR->m_spatialCamera.pan.x, PMONITOR->m_spatialCamera.pan.y);
+    };
+
+    m_dispatchers["hyprvx:toggle"] = [getHyprVXMonitor](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:toggle"};
+        PMONITOR->m_spatialCamera.enabled = !PMONITOR->m_spatialCamera.enabled;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] toggle -> enabled = {}", PMONITOR->m_spatialCamera.enabled);
+        return {};
+    };
+
+    m_dispatchers["hyprvx:enable"] = [getHyprVXMonitor](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:enable"};
+        PMONITOR->m_spatialCamera.enabled = true;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] enable -> enabled = true");
+        return {};
+    };
+
+    m_dispatchers["hyprvx:disable"] = [getHyprVXMonitor](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:disable"};
+        PMONITOR->m_spatialCamera.enabled = false;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] disable -> enabled = false");
+        return {};
+    };
+
+    m_dispatchers["hyprvx:reset"] = [getHyprVXMonitor](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:reset"};
+        PMONITOR->m_spatialCamera.pan = {0, 0};
+        PMONITOR->m_spatialCamera.zoom = 1.0f;
+        g_pHyprRenderer->damageMonitor(PMONITOR);
+        Log::logger->log(Log::INFO, "[HyprVX] reset -> pan=(0, 0), zoom=1.0");
+        return {};
+    };
+
+    m_dispatchers["hyprvx:zoom_in"] = [getHyprVXMonitor, zoomCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:zoom_in"};
+        zoomCamera(PMONITOR, +0.10f);
+        return {};
+    };
+
+    m_dispatchers["hyprvx:zoom_out"] = [getHyprVXMonitor, zoomCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:zoom_out"};
+        zoomCamera(PMONITOR, -0.10f);
+        return {};
+    };
+
+    m_dispatchers["hyprvx:pan_left"] = [getHyprVXMonitor, panCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:pan_left"};
+        panCamera(PMONITOR, {-100.f, 0.f});
+        return {};
+    };
+
+    m_dispatchers["hyprvx:pan_right"] = [getHyprVXMonitor, panCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:pan_right"};
+        panCamera(PMONITOR, {100.f, 0.f});
+        return {};
+    };
+
+    m_dispatchers["hyprvx:pan_up"] = [getHyprVXMonitor, panCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:pan_up"};
+        panCamera(PMONITOR, {0.f, -100.f});
+        return {};
+    };
+
+    m_dispatchers["hyprvx:pan_down"] = [getHyprVXMonitor, panCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:pan_down"};
+        panCamera(PMONITOR, {0.f, 100.f});
+        return {};
+    };
+
+    m_dispatchers["hyprvx:pan"] = [getHyprVXMonitor, panCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:pan"};
+        std::istringstream iss(args);
+        float dx = 0.f, dy = 0.f;
+        if (iss >> dx >> dy) {
+            panCamera(PMONITOR, {dx, dy});
+            return {};
+        }
+        return {.success = false, .error = "hyprvx:pan requires dx and dy arguments"};
+    };
+
+    m_dispatchers["hyprvx:zoom"] = [getHyprVXMonitor, zoomCamera](std::string args) -> SDispatchResult {
+        const auto PMONITOR = getHyprVXMonitor();
+        if (!PMONITOR)
+            return {.success = false, .error = "No active monitor for hyprvx:zoom"};
+        try {
+            float targetZoom = std::stof(args);
+            const float oldZoom = (std::isfinite(PMONITOR->m_spatialCamera.zoom) && PMONITOR->m_spatialCamera.zoom > 0.0001f) ? PMONITOR->m_spatialCamera.zoom : 1.0f;
+            zoomCamera(PMONITOR, targetZoom - oldZoom);
+            return {};
+        } catch (...) {
+            return {.success = false, .error = "hyprvx:zoom invalid float value"};
+        }
+    };
+
     m_scrollTimer.reset();
 
     m_longPressTimer = makeShared<CEventLoopTimer>(
diff --git a/src/output/Monitor.hpp b/src/output/Monitor.hpp
index 945fecd..73514fd 100644
--- a/src/output/Monitor.hpp
+++ b/src/output/Monitor.hpp
@@ -37,6 +37,12 @@
 class CSyncTimeline;
 class CEventLoopTimer;
 
+struct SSpatialCameraTransform {
+    bool     enabled = false;
+    Vector2D pan     = {0, 0};
+    float    zoom    = 1.0f;
+};
+
 namespace Monitor {
     class CMonitorResources;
     class CMonitorFrameScheduler;
@@ -372,6 +378,8 @@ namespace Monitor {
         bool                                m_blurFBDirty        = true;
         bool                                m_blurFBShouldRender = false;
 
+        SSpatialCameraTransform             m_spatialCamera;
+
         // For the list lookup
 
         bool operator==(const CMonitor& rhs) {
