# HyprVX native test config, identical for every variant (contracts/test-tooling.md section 5).
# Rendered per nested session by tools/hyprvx_nested.py: @WIDTH@, @HEIGHT@ and @SCALE@ are replaced; nothing else
# changes between stock, v2 and patched. Hyprlang (legacy) format: an explicit --config path without a .lua
# extension selects the legacy parser in Hyprland efb5099 (src/config/ConfigManager.cpp). Every key below was
# checked against src/config/values/ConfigValues.cpp of efb5099; a config error would draw an error bar into captures.

# Tests render on a headless output with a fixed mode, created by tools/hyprvx_nested.py after start
# (`hyprctl output create headless HVX-1`). The Wayland-backend output (the nested window on the host) gets whatever
# size the host layout gives it, so it is disabled and never captured.
monitor = HVX-1, @WIDTH@x@HEIGHT@@60, 0x0, @SCALE@
monitor = WAYLAND-1, disable

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 2
    col.active_border = rgb(888888)
    col.inactive_border = rgb(888888)
    # Border resize drags exist so that t_drag_scope.sh can prove they are blocked while the camera is non-identity.
    resize_on_border = true
}

decoration {
    rounding = 0
    dim_inactive = false
    blur {
        enabled = false
    }
    shadow {
        enabled = false
    }
}

animations {
    enabled = false
}

# File logging after startup (stdout logs stay off): t_drag_scope.sh checks the patched build's blocked-drag WARN lines.
debug {
    disable_logs = false
}

misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
    background_color = rgb(111111)
    disable_autoreload = true
    # Startup notifications would be drawn into captures; tools/hyprvx_nested.py also dismisses the remaining
    # unconditional .conf-format notice right after start.
    disable_watchdog_warning = true
    disable_hyprland_guiutils_check = true
}

cursor {
    inactive_timeout = 1
    # The cursor sprite is never judged; inactive_timeout alone races a capture taken within 1 s of a pointer device
    # appearing (hyprvx-vpointer), which put the sprite into some t_popup identity captures but not others.
    invisible = true
}

ecosystem {
    no_update_news = true
    no_donation_nag = true
}

input {
    kb_layout = us
}

render {
    direct_scanout = 0
}

# Startup marker: exec-once runs in the same event-loop callback that posts the startup notifications, so once
# this file exists a hyprctl request (dismissnotify) is handled after them (tools/hyprvx_nested.py).
exec-once = touch "$XDG_RUNTIME_DIR/hyprvx-exec-once"

# The test client floats at a fixed logical position with its own fixed size (min = max size).
windowrule = match:class ^(hyprvx-testclient)$, float on, move 140 100
# Second client for the focus test (t_focus.sh, app-id hyprvx-testclient-b) and the Feature 002 multi-window scenes.
windowrule = match:class ^(hyprvx-testclient-b)$, float on, move 960 560
# Feature 002 (test-tooling 1.4 section 5): a third Wayland client for multi-window scenes, and the X11 test client
# (WM_CLASS hyprvx-x11client), both floating at fixed positions. No Feature 001 test starts them.
windowrule = match:class ^(hyprvx-testclient-c)$, float on, move 520 320
windowrule = match:class ^(hyprvx-x11client)$, float on, move 240 160
# Second X11 client of the T042 fallback case (its menu has no WM_TRANSIENT_FOR).
windowrule = match:class ^(hyprvx-x11client-y)$, float on, move 40 380

# Compositor move drag without a modifier: hyprvx-vpointer has no keyboard, so the side button (BTN_SIDE, 275) stands
# in for Super+LMB (same movewindow mouse bind and drag controller). Only t_drag_scope.sh presses it.
bindm = , mouse:275, movewindow
# Hyprland's own resize bind for T-RESIZE (Feature 002 FR-009), on BTN_EXTRA (276) for the same reason; only t_resize.sh
# presses it.
bindm = , mouse:276, resizewindow

# Feature 003 (test-tooling 1.5 section 5): the user's window-action trackpad bindings, so that arbitration is tested
# against the real conflict (host config read-only: config/inputs.lua, hyprland/gestures.lua). Command bindings (the
# host's 4-finger suspend, special-workspace toggles bound to functions) are never copied. Only the Feature 003 tests
# send gestures (synthetic, through the test-only plugin); no earlier test is affected.
gesture = 3, down, close
gesture = 3, up, fullscreen
gesture = 3, left, float
gesture = 4, horizontal, workspace
